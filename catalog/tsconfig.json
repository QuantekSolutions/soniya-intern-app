{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
  "**/*.ts",
  "**/*.tsx",
  "**/*.d.ts",
  "**/*.css",
  ".expo/types/**/*.ts",
  "expo-env.d.ts"
]

}
